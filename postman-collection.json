{
  "info": {
    "_postman_id": "itau-microsservicos-collection",
    "name": "Itaú Microsserviços",
    "description": "Collection completa para testar os microsserviços LoginService, TransactionService e GameService",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_login",
      "value": "http://localhost:8081/api/v1",
      "type": "string"
    },
    {
      "key": "base_transaction",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "base_game",
      "value": "http://localhost:8082",
      "type": "string"
    },
    {
      "key": "TOKEN",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🔑 LoginService",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set('TOKEN', jsonData.token);",
                  "    console.log('Token salvo:', jsonData.token.substring(0, 20) + '...');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"Thiago\",\n  \"password\": \"231299\"\n}"
            },
            "url": {
              "raw": "{{base_login}}/auth/login",
              "host": ["{{base_login}}"],
              "path": ["auth", "login"]
            },
            "description": "Autentica o usuário e retorna um token JWT. O token é salvo automaticamente na variável TOKEN da collection."
          },
          "response": []
        },
        {
          "name": "Me (Dados do Usuário)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{base_login}}/auth/me",
              "host": ["{{base_login}}"],
              "path": ["auth", "me"]
            },
            "description": "Retorna os dados da sessão do usuário autenticado. Requer Bearer token."
          },
          "response": []
        },
        {
          "name": "Contract (Contratar Serviço)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              }
            ],
            "url": {
              "raw": "{{base_login}}/contract",
              "host": ["{{base_login}}"],
              "path": ["contract"]
            },
            "description": "Contrata o serviço de transações para o usuário. Deve ser chamado antes de criar transações."
          },
          "response": []
        },
        {
          "name": "Health Check — LoginService",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_login}}/actuator/health",
              "host": ["{{base_login}}"],
              "path": ["actuator", "health"]
            },
            "description": "Verifica a saúde do LoginService."
          },
          "response": []
        }
      ]
    },
    {
      "name": "💳 TransactionService",
      "item": [
        {
          "name": "Criar Transação",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Gerar UUID para idempotency key",
                  "function generateUUID() {",
                  "    return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {",
                  "        var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);",
                  "        return v.toString(16);",
                  "    });",
                  "}",
                  "pm.variables.set('idempotency_key', generateUUID());",
                  "console.log('Idempotency Key:', pm.variables.get('idempotency_key'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{TOKEN}}"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{idempotency_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"DEPOSITO\",\n  \"amount\": 100.50\n}"
            },
            "url": {
              "raw": "{{base_transaction}}/transactions",
              "host": ["{{base_transaction}}"],
              "path": ["transactions"]
            },
            "description": "Cria uma nova transação. Retorna HTTP 202 Accepted com transactionId. O header X-Idempotency-Key é gerado automaticamente pelo script pre-request."
          },
          "response": []
        },
        {
          "name": "Health Check — TransactionService",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_transaction}}/actuator/health",
              "host": ["{{base_transaction}}"],
              "path": ["actuator", "health"]
            },
            "description": "Verifica a saúde do TransactionService incluindo o estado do circuit breaker."
          },
          "response": []
        },
        {
          "name": "Métricas — TransactionService",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_transaction}}/actuator/metrics",
              "host": ["{{base_transaction}}"],
              "path": ["actuator", "metrics"]
            },
            "description": "Retorna as métricas do TransactionService."
          },
          "response": []
        }
      ]
    },
    {
      "name": "🎮 GameService",
      "item": [
        {
          "name": "Health Check — GameService",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_game}}/actuator/health",
              "host": ["{{base_game}}"],
              "path": ["actuator", "health"]
            },
            "description": "Verifica a saúde do GameService."
          },
          "response": []
        },
        {
          "name": "Métricas — GameService",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_game}}/actuator/metrics",
              "host": ["{{base_game}}"],
              "path": ["actuator", "metrics"]
            },
            "description": "Retorna as métricas do GameService."
          },
          "response": []
        }
      ]
    }
  ]
}
